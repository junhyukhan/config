# The core: what every new Mac gets from setup.sh. Apps kept only on one machine stay
# out of this file and are simply installed there. Never run `brew bundle cleanup` against
# it: that would uninstall everything else brew put on the machine. See docs/new-mac.md.

tap "infisical/get-cli"
# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
