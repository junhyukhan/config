{
  "model": "opus",
  "enabledPlugins": {
    "discord@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q '\"command\".*git commit'; then git push 2>/dev/null; fi",
            "if": "Bash(git commit*)",
            "async": true
          }
        ]
      }
    ]
  }
}
